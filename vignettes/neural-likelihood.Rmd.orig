knitr::opts_chunk$set(
  collapse = TRUE, comment = "#>", error = FALSE,
  fig.path = "figures/neural-likelihood-", fig.width = 6, fig.height = 3.6,
  dpi = 96, fig.retina = NULL, dev = "svglite"
)
set.seed(1)

if (requireNamespace("future", quietly = TRUE)) {
  future::plan(future::multisession)
}
has_cmdstan <- requireNamespace("cmdstanr", quietly = TRUE) &&
  !is.null(tryCatch(cmdstanr::cmdstan_version(), error = function(e) NULL))
